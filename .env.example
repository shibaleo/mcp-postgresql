# Canonical app URL — used as the OAuth issuer and for /redirect_uri building.
# On Vercel leave unset; VERCEL_PROJECT_PRODUCTION_URL is auto-injected and
# we fall back to the request host in local dev.
APP_URL=https://mcpist-vc.vercel.app

# Clerk — only the owner (OWNER_EMAIL in src/lib/auth.ts) is allowed in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Ed25519 seed (32 bytes base64). Used to sign authorization codes,
# refresh tokens, and access tokens. Rotate the key (re-deploy) to
# invalidate every issued token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_JWT_SIGNING_KEY=

# Registry DB — holds the mcpist.connections table that lists the named
# PostgreSQL databases the owner has registered via the SPA UI. Same Neon
# project as the data DB is fine; the registry table lives in its own
# `mcpist` schema.
MCPIST_REGISTRY_DATABASE_URL=postgresql://user:pass@host:5432/db

# 32-byte base64 key — encrypts connection strings at rest in
# mcpist.connections. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
