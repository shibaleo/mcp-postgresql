# ────────────────────────────────────────────────────────────────────────
# ローカルに置くのは .env.local の BWS_ACCESS_TOKEN 1本だけ。
# 実 secret は Bitwarden Secrets Manager (bws) から注入され、非機密 config は
# src/lib/public-config.ts に commit 済み。詳細は SECRETS.md。
#
#   .env.local:
#     BWS_ACCESS_TOKEN=<bitwarden machine account token>
#
# 下記は「稼働アプリが process.env から runtime に読む app secret」の一覧
# (参考)。ローカル=bws dev-secrets が注入 / prod=Vercel Production env が供給。
# ここに実値を書く必要はない。
# ────────────────────────────────────────────────────────────────────────

# Clerk secret key (sk_test/sk_live)。owner の email lookup に使う。
# data-drills / data-meals と同一 Clerk インスタンス共有 = 同値 (bare key)。
CLERK_SECRET_KEY=

# 接続レジストリ DB (mcp_postgresql.connections)。共有 Neon hub の
# dev=development / prod=production ブランチ (pooled)。
MCP_POSTGRESQL_REGISTRY_DATABASE_URL=

# Ed25519 seed (32 bytes base64)。authorization code / refresh / access
# token の署名鍵。dev/prod で別値。生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MCP_POSTGRESQL_SERVER_JWT_SIGNING_KEY=

# 32-byte base64 鍵。mcp_postgresql.connections の接続文字列を at-rest 暗号化。
# dev/prod で別値。生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MCP_POSTGRESQL_CREDENTIAL_ENCRYPTION_KEY=

# ── 非機密 config は env ではなく src/lib/public-config.ts (git 追跡) ──
#   clerkPublishableKey (pk_test/pk_live) / baseUrl (prod=postgresql.mcp.shibaleo.uk)
